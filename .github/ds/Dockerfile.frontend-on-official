# Design Studio: the frontend image on top of the official one.
#
# Upstream's docker/images/Dockerfile.frontend starts FROM dhi.io (Docker
# Hardened Images), which refuses anonymous pulls. The official
# penpotapp/frontend image at our base tag is that Dockerfile's own output, so
# we start from it (pinned by digest in the workflow) and redo only the steps
# that depend on our sources: the bundle, config.js, the nginx templates, the
# CSP hash file and the ownership fix. nginx, its modules, the entrypoint and
# the penpot user stay exactly as in the official release.
#
# Build context: docker/images (same as upstream), with the bundle copied to
# docker/images/bundle-frontend/.

# The result is flattened into one layer (F2 WP0): built on top of the official
# image, the old web root stayed in a lower layer and the image was 1.1 GB
# instead of 590 MB. The final stage copies the finished filesystem into
# scratch and restates the official image's config (user, env, port,
# entrypoint, command), read from penpotapp/frontend:2.18.7 on 2026-11-15.
# Re-check that config on every rebase.

ARG OFFICIAL_IMAGE=penpotapp/frontend:2.18.7@sha256:65109ceb13f28fc0d040c404d5e006689c491b899a4229d084a84b73edc266c7
FROM ${OFFICIAL_IMAGE} AS assembled

USER root

RUN rm -rf /var/www/app /etc/nginx/csp-script-hashes.txt

ARG BUNDLE_PATH="./bundle-frontend/"
COPY $BUNDLE_PATH /var/www/app/
COPY ./files/config.js /var/www/app/js/config.js
COPY ./files/nginx.conf.template /tmp/nginx.conf.template
COPY ./files/nginx-resolvers.conf.template /tmp/resolvers.conf.template
COPY ./files/nginx-admin-console-locations.conf.template /tmp/nginx-admin-console-locations.conf.template
COPY ./files/nginx-mcp-locations.conf.template /tmp/nginx-mcp-locations.conf.template
COPY ./files/nginx-security-headers.conf.template /tmp/nginx-security-headers.conf.template
COPY ./files/nginx-mime.types /etc/nginx/mime.types
COPY ./files/nginx-external-locations.conf /etc/nginx/overrides/location.d/external-locations.conf
COPY ./files/nginx-entrypoint.sh /entrypoint.sh

# Same as upstream: move the hash file when the bundle has one. The 2.18.7
# bundle and the official 2.18.7 image have none, and nginx-entrypoint.sh
# handles that. The official copy (if any) was removed above, so the result
# always matches our bundle.
RUN if [ -f /var/www/app/csp-script-hashes.txt ]; then \
        mv /var/www/app/csp-script-hashes.txt /etc/nginx/csp-script-hashes.txt; \
    else \
        echo "WARNING: the frontend bundle does not provide csp-script-hashes.txt" >&2; \
    fi

RUN chown -R 1001:0 /etc/nginx /var/www; \
    chmod -R g+w /etc/nginx /var/www

FROM scratch
COPY --from=assembled / /
ENV DEBIAN_FRONTEND=noninteractive \
    NGINX_VERSION=1.31.8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PKG_RELEASE=0
LABEL maintainer="Design Studio <hello@zakacoding.dev>" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.source="https://github.com/ZakaCoding/design-studio-editor"
EXPOSE 8080
WORKDIR /
USER penpot:penpot
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
